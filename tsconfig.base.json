{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": { "@shared/*": ["./src/shared/*"], "@core/*": ["./src/core/*"], "@renderer/*": ["./src/renderer/*"] }
  }
}
